#!/usr/bin/env node
// tmux-server CLI entry point. Kept at this path (and without an extension)
// because install.sh symlinks ~/.local/bin/tmux-server here and the system
// service runs it by this name; the CLI itself is cli/tmux-server/main.ts.
// Node resolves the ~/.local/bin symlink for the entry script, so __dirname
// is the repo's bin/.
const major = Number(process.versions.node.split(".")[0]);
if (major < 23) {
  console.error(`tmux-server needs Node.js 23 or newer (found ${process.version}) - install it from https://nodejs.org`);
  process.exit(1);
}
import(require("node:path").join(__dirname, "..", "cli", "tmux-server", "main.ts"));
